        "partitions": [
          {
            "name": "Services",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    View = MySQL.Database(QueueWiseServer, QueueWiseDatabase, [Query = \"SELECT * FROM vw_services\"]),",
                "    Typed = Table.TransformColumnTypes(View, {{\"service_id\", Int64.Type}}),",
                "    Labels = Table.AddColumn(Typed, \"Service Label\", each [service_name] & \" (\" & [service_code] & \")\", type text)",
                "in",
                "    Labels"
              ],
              "type": "m"
            }
          }
        ]
      },
