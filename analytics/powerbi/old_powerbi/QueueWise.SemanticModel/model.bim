          }
        ],
        "lineageTag": "bee5ff9e-b2a6-4abe-9c0e-ee901235f784",
        "measures": [
          {
            "name": "Counter Completed Tokens",
            "expression": "COALESCE(SUM(CounterDays[completed_tokens]), 0)",
            "formatString": "#,0",
            "lineageTag": "82b4bc45-6615-4deb-8225-48e717227bbc"
          },
          {
            "name": "Counter Utilization",
            "expression": "DIVIDE(SUM(CounterDays[busy_seconds]), SUM(CounterDays[staffed_seconds]))",
            "formatString": "0.0%",
            "lineageTag": "f6bb8886-de40-4535-b8aa-2c630f1a30c0"
          },
          {
            "name": "Counter Average Handling Minutes",
            "expression": "DIVIDE(DIVIDE(SUM(CounterDays[handling_seconds]), [Counter Completed Tokens]), 60)",
            "formatString": "0.00",
            "lineageTag": "5df074e6-54f1-47a3-90e5-3155121e0c01"
          },
          {
            "name": "Staffed Hours",
            "expression": "DIVIDE(SUM(CounterDays[staffed_seconds]), 3600)",
            "formatString": "0.00",
            "lineageTag": "f44d6902-0b9f-4c38-b95e-a38283ab020e"
          },
          {
            "name": "Busy Hours",
            "expression": "DIVIDE(SUM(CounterDays[busy_seconds]), 3600)",
            "formatString": "0.00",
            "lineageTag": "9a520df3-bf4a-4789-8df6-3cd5f3ad2978"
          }
        ],
        "partitions": [
          {
            "name": "CounterDays",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    View = MySQL.Database(QueueWiseServer, QueueWiseDatabase, [Query = \"SELECT * FROM vw_counter_performance\"]),",
                "    Typed = Table.TransformColumnTypes(View, {{\"counter_id\", Int64.Type}, {\"service_id\", Int64.Type}, {\"completed_tokens\", Int64.Type}, {\"work_date\", type date}, {\"staffed_seconds\", type number}, {\"busy_seconds\", type number}, {\"handling_seconds\", type number}})",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Calendar",
        "columns": [
          {
            "name": "Date",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
