            "summarizeBy": "none"
          },
          {
            "name": "Week Start",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "dataType": "dateTime",
            "formatString": "yyyy-MM-dd",
            "lineageTag": "079fbb2d-a189-4acc-a887-3e958ee14815",
            "sourceColumn": "Week Start",
            "summarizeBy": "none"
          },
          {
            "name": "Weekday",
            "dataType": "string",
            "lineageTag": "4f09ed48-c1bf-4e88-bfbf-9e9e400bc581",
            "sortByColumn": "Weekday Number",
            "sourceColumn": "Weekday",
            "summarizeBy": "none"
          },
          {
            "name": "Weekday Number",
            "dataType": "int64",
            "isHidden": true,
            "lineageTag": "548d4cbd-61fb-4197-98b2-c36a58c1248d",
            "sourceColumn": "Weekday Number",
            "summarizeBy": "none"
          }
        ],
        "dataCategory": "Time",
        "lineageTag": "2ae27be6-2cd7-4468-80c5-f1ba3182b8ec",
        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Today = Date.From(DateTimeZone.SwitchZone(DateTimeZone.FixedUtcNow(), 5, 30)),",
                "    Observed = List.RemoveNulls(List.Combine({Tokens[queue_date], CounterDays[work_date]})),",
                "    First = Date.StartOfYear(List.Min(Observed & {Today})),",
                "    Last = Date.EndOfYear(List.Max(Observed & {Today})),",
                "    Dates = Table.FromColumns({List.Dates(First, Duration.Days(Last - First) + 1, #duration(1, 0, 0, 0))}, {\"Date\"}),",
                "    Typed = Table.TransformColumnTypes(Dates, {{\"Date\", type date}}),",
                "    WeekStart = Table.AddColumn(Typed, \"Week Start\", each Date.StartOfWeek([Date], Day.Monday), type date),",
                "    Weekday = Table.AddColumn(WeekStart, \"Weekday\", each Date.DayOfWeekName([Date], \"en-IN\"), type text),",
                "    WeekdayNumber = Table.AddColumn(Weekday, \"Weekday Number\", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type)",
                "in",
                "    WeekdayNumber"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}