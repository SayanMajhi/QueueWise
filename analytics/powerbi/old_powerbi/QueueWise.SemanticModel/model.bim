        "lineageTag": "c60c3c70-69ab-44ac-bbfb-d0e43c4dc158",
        "measures": [
          {
            "name": "Tokens Issued",
            "expression": "COALESCE(COUNTROWS(Tokens), 0)",
            "formatString": "#,0",
            "lineageTag": "49c1f5b6-abe4-4265-961e-4dc17459156f"
          },
          {
            "name": "Tokens Completed",
            "expression": "CALCULATE([Tokens Issued], KEEPFILTERS(Tokens[status] = \"COMPLETED\"))",
            "formatString": "#,0",
            "lineageTag": "26bc3cc3-f151-42ef-a847-22a66bbc4760"
          },
          {
            "name": "Completion Rate",
            "expression": "DIVIDE([Tokens Completed], [Tokens Issued])",
            "formatString": "0.0%",
            "lineageTag": "4166fb99-e74f-4261-bf4d-ebe38924d9f4"
          },
          {
            "name": "Wait Samples",
            "expression": "COALESCE(COUNT(Tokens[wait_seconds]), 0)",
            "formatString": "#,0",
            "lineageTag": "be824405-7b9c-4c42-be33-7f623cc48d42"
          },
          {
            "name": "Average Wait Minutes",
            "expression": "DIVIDE(AVERAGE(Tokens[wait_seconds]), 60)",
            "formatString": "0.00",
            "lineageTag": "a928b637-3d70-47db-b2b6-2959ff97ba5e"
          },
          {
            "name": "P90 Wait Minutes",
            "expression": "VAR Samples = [Wait Samples] VAR Observed = FILTER(Tokens, NOT ISBLANK(Tokens[wait_seconds])) RETURN SWITCH(Samples, 0, BLANK(), 1, DIVIDE(MIN(Tokens[wait_seconds]), 60), DIVIDE(PERCENTILEX.INC(Observed, Tokens[wait_seconds], 0.9), 60))",
            "formatString": "0.00",
            "lineageTag": "2e89b52d-8a44-481d-beb7-698ef3100d13"
          },
          {
            "name": "Average Service Minutes",
            "expression": "DIVIDE(AVERAGE(Tokens[handling_seconds]), 60)",
            "formatString": "0.00",
            "lineageTag": "37968aac-8754-4b37-abae-898c3d94f653"
          },
          {
            "name": "Handling Samples",
            "expression": "COUNT(Tokens[handling_seconds])",
            "formatString": "#,0",
            "lineageTag": "9e054a6c-9585-427a-82f0-eff611b41fda"
          }
        ],
        "partitions": [
          {
            "name": "Tokens",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    View = MySQL.Database(QueueWiseServer, QueueWiseDatabase, [Query = \"SELECT * FROM vw_token_lifecycle\"]),",
                "    Typed = Table.TransformColumnTypes(View, {{\"service_id\", Int64.Type}, {\"counter_id\", Int64.Type}, {\"arrival_hour\", Int64.Type}, {\"estimate_seconds\", Int64.Type}, {\"queue_date\", type date}, {\"completion_date\", type date}, {\"wait_seconds\", type number}, {\"handling_seconds\", type number}}),",
                "    BandOrder = Table.AddColumn(Typed, \"handling_band_order\", each",
                "        if [handling_seconds] = null then null else if [handling_seconds] < 120 then 1",
                "        else if [handling_seconds] < 240 then 2 else if [handling_seconds] < 360 then 3 else 4, Int64.Type),",
                "    Bands = Table.AddColumn(BandOrder, \"handling_band\", each",
                "        if [handling_band_order] = null then null",
                "        else {\"Under 2 min\", \"2–<4 min\", \"4–<6 min\", \"6 min or more\"}{[handling_band_order] - 1}, type text)",
                "in",
                "    Bands"
              ],
              "type": "m"
            }
          }
        ]
      },
