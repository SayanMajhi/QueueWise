          {
            "name": "Counters",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    View = MySQL.Database(QueueWiseServer, QueueWiseDatabase, [Query = \"SELECT * FROM vw_counters\"]),",
                "    Typed = Table.TransformColumnTypes(View, {{\"counter_id\", Int64.Type}, {\"service_id\", Int64.Type}}),",
                "    Joined = Table.NestedJoin(Typed, {\"service_id\"}, Services, {\"service_id\"}, \"Service\", JoinKind.LeftOuter),",
                "    ServiceCode = Table.ExpandTableColumn(Joined, \"Service\", {\"service_code\"}),",
                "    Labels = Table.AddColumn(ServiceCode, \"Counter Label\", each [counter_name] & \" (\" & [service_code] & \" / \" & [counter_code] & \")\", type text)",
                "in",
                "    Labels"
              ],
              "type": "m"
            }
          }
        ]
