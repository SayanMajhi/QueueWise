table 'queuewise vw_token_lifecycle'
	lineageTag: d9ce6480-b05e-4c41-bfaa-00aa6357f1d3

	measure 'Total Tokens' = COUNTROWS('queuewise vw_token_lifecycle')
		formatString: 0
		lineageTag: 633a0cbe-e7e3-497e-871e-b9ad16ec234e

	measure 'Completed Tokens' =
			
			CALCULATE(
			    [Total Tokens],
			    'queuewise vw_token_lifecycle'[status] = "COMPLETED"
			)
		formatString: 0
		lineageTag: e90f07cf-ad98-46bc-aedb-6f5869456759

	measure Measure
		lineageTag: 8c4d9cd9-05a9-4eb5-9280-1e15d666e287

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Completion Rate' =
			
			DIVIDE([Completed Tokens], [Total Tokens], 0)
		lineageTag: d3f51ab7-514c-48a2-a038-0ad8a2ec1737

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Wait Minutes' =
			
			DIVIDE(
			    AVERAGE('queuewise vw_token_lifecycle'[wait_seconds]),
			    60
			)
		lineageTag: 9d69bb96-0845-45e2-aefd-eb8fe87454d1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Service Minutes' =
			
			DIVIDE(
