table 'queuewise vw_counter_performance'
	lineageTag: 2d3ce5d6-4a53-439b-a3c8-0d4819ec8dea

	measure 'Counter Completed Tokens' =
			
			COALESCE(
			    SUM('queuewise vw_counter_performance'[completed_tokens]),
			    0
			)
		formatString: 0
		lineageTag: 39306bb0-bf21-4fa8-97a2-0d66fec03aac

	measure 'Counter Utilization' =
			
			DIVIDE(
			    SUM('queuewise vw_counter_performance'[busy_seconds]),
			    SUM('queuewise vw_counter_performance'[staffed_seconds])
			)
		lineageTag: 74aae82c-a9ee-4c58-8317-639f84e28787

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column counter_id
		dataType: int64
		formatString: 0
