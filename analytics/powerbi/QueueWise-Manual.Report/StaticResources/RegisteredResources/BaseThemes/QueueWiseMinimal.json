{
  "name": "QueueWise Minimal",
  "dataColors": [
    "#4B4438",
    "#B38712",
    "#667653",
    "#8C6855",
    "#687B86",
    "#9B788A",
    "#746E62"
  ],
  "background": "#FFFDFA",
  "foreground": "#211F1B",
  "tableAccent": "#171715",
  "textClasses": {
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 12,
      "color": "#60594E"
    },
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 30,
      "color": "#211F1B"
    },
    "title": {
      "fontFace": "Segoe UI",
      "fontSize": 15,
      "color": "#211F1B"
    },
    "header": {
      "fontFace": "Segoe UI",
      "fontSize": 13,
      "color": "#211F1B"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F6F1E9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFDFA"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "width": 1,
            "radius": 8,
            "color": {
              "solid": {
                "color": "#E8E0D4"
              }
            }
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "left": 16,
            "right": 16,
            "top": 12,
            "bottom": 12
          }
        ],
        "title": [
          {
            "alignment": "left",
            "fontFamily": "Segoe UI",
            "fontSize": 15,
            "fontColor": {
              "solid": {
                "color": "#211F1B"
              }
            },
            "bold": true
          }
        ]
      }
    }
  }
}